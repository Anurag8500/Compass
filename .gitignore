# Python virtual environment
.venv/
env/
venv/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
build/
dist/

# Raw dataset files (Immutable raw data must NEVER be committed to Git)
data/raw/
