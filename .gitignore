# Derived processed dataset cache (reproducible from raw + pipeline, never committed)
data/cache/
data/cache/*
*.npz

# ML models and binary artifacts
models/*.onnx
models/*.tflite
models/*.pt
models/*.pth
*.onnx
*.tflite

# IDE / Editor folders
.ipynb_checkpoints/
.idea/
.vscode/

# OS specific
.DS_Store
Thumbs.db