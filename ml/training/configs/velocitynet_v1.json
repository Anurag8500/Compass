{
  "model_name": "VelocityNet",
  "version": "v1.0",
  "seed": 42,
  "input_dim": 9,
  "hidden_dim": 64,
  "num_layers": 2,
  "dense_dim": 32,
  "dropout": 0.2,
  "learning_rate": 0.001,
  "weight_decay": 1e-05,
  "batch_size": 256,
  "max_epochs": 15,
  "patience": 5,
  "min_log_var": -10.0,
  "max_log_var": 10.0,
  "scheduler_t_max": 20,
  "scheduler_eta_min": 1e-05,
  "train_split": "data/ml_dataset_v1/train.npz",
  "val_split": "data/ml_dataset_v1/validation.npz",
  "test_split": "data/ml_dataset_v1/test.npz",
  "checkpoint_dir": "models",
  "history_path": "models/velocitynet_v1_history.json"
}
